# ============================================================
#  Video Template SaaS — the only values you MUST fill in are
#  INKSTONE_BASE_URL and INKSTONE_API_KEY (run.py creates .env
#  for you and generates SECRET_KEY / ADMIN_PASSWORD).
# ============================================================

# --- Intern Inkstone: ONE main key reaches all 14 models (model ids are built in) ---
INKSTONE_BASE_URL=
INKSTONE_API_KEY=

# --- MiniMax-H3 video generation (separate key from Inkstone) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-H3
# Endpoint paths; if the query path differs for your account run: python scripts/check_minimax.py
MINIMAX_CREATE_PATH=/v2/video_generation
MINIMAX_QUERY_PATH=/v2/video_generation/{task_id}
MINIMAX_POLL_SECONDS=3
MINIMAX_MAX_WAIT_SECONDS=1200
# Extra JSON merged into the create request, e.g. {"generate_audio": true}
MINIMAX_EXTRA_PARAMS=
# Credits per generated second (x multiplier for 2K). MiniMax-H3 list price: $0.08/s at 768P, $0.13/s at 2K
# (2K/768P = 1.625). 1 credit = 1.000đ in the default top-up packs, so 4 credits/s ~ 2x the API cost.
# Dance = this + HEAVY_RENDER_COST.
AI_VIDEO_CREDITS_PER_SEC=4
AI_VIDEO_2K_MULTIPLIER=1.625

# --- Core (run.py generates these on first start) ---
APP_ENV=dev
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage

# --- Initial prices only: after first start the admin 'Bảng giá' tab is the source of truth ---
FAST_RENDER_COST=1
HEAVY_RENDER_COST=10

# --- VietQR (account shown on the QR) + webhook secrets from SePay / Casso ---
BANK_BIN=vcb
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=NGUYEN VAN A
SEPAY_API_KEY=
CASSO_SECURE_TOKEN=
TX_TTL_SECONDS=300
LATE_PAYMENT_AUTOCREDIT=0

# --- Heavy render: MimicMotion + Celery/Redis (optional, needs an NVIDIA GPU) ---
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=0
MIMICMOTION_DIR=./vendor/MimicMotion
MIMICMOTION_PYTHON=python3
MIMICMOTION_BASE_MODEL=stabilityai/stable-video-diffusion-img2vid-xt-1-1
MIMICMOTION_CKPT=models/MimicMotion_1-1.pth
MIMICMOTION_NUM_FRAMES=72

# --- Muse AI (via FlowKit provider queue + Muse Kit Chrome extension) ---
# Cần chạy muse2api gateway (127.0.0.1:8100) + Chrome extension Muse Kit + tài khoản muse.ai đã đăng nhập.
# Cookie muse.ai nhập vào muse2api gateway (xem import_cookies.py). Để trống nếu không dùng.
MUSE_BASE_URL=http://127.0.0.1:8100
MUSE_TIMEOUT_SECONDS=900

# --- Stuck-job reaper (seconds) ---
FAST_TIMEOUT_SECONDS=600
HEAVY_TIMEOUT_SECONDS=5400
HEAVY_QUEUE_TIMEOUT_SECONDS=21600
